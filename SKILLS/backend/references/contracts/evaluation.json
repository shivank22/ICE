{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation.json",
  "title": "Evaluation",
  "type": "object",
  "required": ["evaluation_id", "subject", "scores", "pass"],
  "properties": {
    "evaluation_id": { "type": "string" },
    "subject": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["run", "episode", "skill_version"] },
        "id": { "type": "string" }
      }
    },
    "criteria_ref": { "type": "string" },
    "scores": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "pass": { "type": "boolean" },
    "inconclusive": { "type": "boolean" },
    "framework": {
      "type": "string",
      "description": "Binding used: deepeval | langsmith | agentevals | custom",
      "enum": ["deepeval", "langsmith", "agentevals", "custom", "hybrid"]
    },
    "trace_id": { "type": "string" },
    "skill_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_id": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "judge_model": { "type": "string" },
    "notes": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
